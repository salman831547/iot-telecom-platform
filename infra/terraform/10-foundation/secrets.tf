# Salt for hashing PII (IMSI, MSISDN, IMEI) in the silver layer.
#
# The value is generated by an EPHEMERAL resource and written through a WRITE-ONLY
# argument, so it never appears in Terraform state, plan output or logs.
# Rotate it by bumping var.pii_salt_version. Note that rotating changes the hashes of
# rows written afterwards.
resource "google_secret_manager_secret" "pii_hash_salt" {
  project   = local.project_id
  secret_id = local.cfg.secrets.pii_hash_salt

  replication {
    user_managed {
      replicas {
        location = local.region
      }
    }
  }

  labels = local.labels
}

ephemeral "random_password" "pii_hash_salt" {
  length  = 48
  special = false
}

resource "google_secret_manager_secret_version" "pii_hash_salt" {
  secret                 = google_secret_manager_secret.pii_hash_salt.id
  secret_data_wo         = ephemeral.random_password.pii_hash_salt.result
  secret_data_wo_version = var.pii_salt_version
}
